# Backend base URL for production builds (leave empty in dev — Vite proxies /api).
VITE_API_URL=

# Dev-only: where the Vite proxy forwards /api. Defaults to http://localhost:5000.
# On macOS port 5000 is often taken by AirPlay Receiver; run the backend with
# PORT=5001 and set this accordingly.
VITE_API_PROXY_TARGET=http://localhost:5000
