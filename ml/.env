# LLM provider for intent extraction (Module 2). Leave unset / "none" to run
# fully offline with the rule-based extractor.
#   openai      -> OpenAI API
#   openrouter  -> https://openrouter.ai/api/v1 (any model, OpenAI-compatible)
#   anthropic   -> Anthropic Claude API
#   ollama      -> local Ollama at http://localhost:11434/v1
#   auto        -> pick from OPENROUTER_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY
LLM_PROVIDER=auto
LLM_API_KEY=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
# Optional overrides
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini        # openrouter example
# LLM_MODEL=claude-sonnet-5           # anthropic example
# LLM_MODEL=gpt-4o-mini               # openai example
# LLM_MODEL=llama3.1                  # ollama example

# Provider-native key vars are also honoured when LLM_API_KEY is empty:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
