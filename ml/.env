# LLM provider for intent extraction (Module 2). Leave unset / "none" to run
# fully offline with the rule-based extractor.
#   openai      -> OpenAI API
#   openrouter  -> https://openrouter.ai/api/v1 (any model, OpenAI-compatible)
#   anthropic   -> Anthropic Claude API
#   ollama      -> local Ollama at http://localhost:11434/v1
#   auto        -> pick from OPENROUTER_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY
# ─── LLM provider for intent extraction (Module 2) ──────────────────────────
# Provider: openrouter  →  https://openrouter.ai/api/v1
# Model: meta-llama/llama-3.1-8b-instruct:free  (free tier, fast, good at JSON)
# Switch to openai/gpt-4o-mini for higher accuracy if you have credits.
LLM_PROVIDER=openrouter
LLM_API_KEY=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
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Alternative free model (lower accuracy, no credits needed):
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ─── CORS ────────────────────────────────────────────────────────────────────
ML_CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:5001

# ─── Fallback key aliases (honoured when LLM_API_KEY is blank) ───────────────
OPENROUTER_API_KEY=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
